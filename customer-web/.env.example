# Browser-accessible customer API base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Customer API base URL reachable from the Next.js server/container.
NEXT_PUBLIC_SSR_API_BASE_URL=http://localhost:3001/api

# Admin API root used for public file delivery. The image helper appends
# /admin/files/{bucket}/{fileName}.
NEXT_PUBLIC_FILES_BASE_URL=http://localhost:3000/api

# Optional only if loading the PayPal SDK independently. The backend initialization
# response already supplies the public client ID; never place a client secret here.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
