# HTTP
PORT=3000

# PostgreSQL
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_with_local_password
DB_NAME=commercor

# Authentication
JWT_SECRET=replace_with_a_long_random_local_secret

# MinIO (endpoint must not include http:// or https://)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=replace_with_local_access_key
MINIO_SECRET_KEY=replace_with_local_secret_key

# PayPal server-side refund credentials (sandbox recommended for development)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Customer CRM segmentation
CRM_NEW_CUSTOMER_DAYS=30
CRM_ACTIVE_DAYS=60
CRM_AT_RISK_DAYS=90
CRM_INACTIVE_DAYS=180
CRM_VIP_MIN_SPEND=1000
CRM_VIP_MIN_ORDERS=10
