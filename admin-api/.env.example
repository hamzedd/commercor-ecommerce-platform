# HTTP
PORT=3000
NODE_ENV=development
ADMIN_WEB_ORIGIN=http://localhost:5173
CUSTOMER_WEB_ORIGIN=http://localhost:3002
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
UPLOAD_MAX_BYTES=5242880

# PostgreSQL
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_with_local_password
DB_NAME=commercor
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Authentication
JWT_SECRET=replace_with_a_long_random_local_secret

# MinIO (endpoint must not include http:// or https://)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=replace_with_local_access_key
MINIO_SECRET_KEY=replace_with_local_secret_key
MINIO_USE_SSL=false

# PayPal server-side refund credentials (sandbox recommended for development)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ALLOW_LIVE=false

# One-time CLI bootstrap inputs. Prefer process-scoped secret injection and remove afterward.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Customer CRM segmentation
CRM_NEW_CUSTOMER_DAYS=30
CRM_ACTIVE_DAYS=60
CRM_AT_RISK_DAYS=90
CRM_INACTIVE_DAYS=180
CRM_VIP_MIN_SPEND=1000
CRM_VIP_MIN_ORDERS=10
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
