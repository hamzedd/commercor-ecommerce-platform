PORT=3001
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=commercorUser
DB_PASSWORD=replace-with-local-password
DB_NAME=commercorDB
JWT_SECRET=replace-with-a-long-random-secret
DOMAIN_URL=http://localhost:3002/en

# No payment can be completed until a verified provider adapter is configured.
PAYMENT_PROVIDER=manual_disabled
PAYMENT_PENDING_EXPIRY_MINUTES=30

# PayPal REST Orders v2. Keep the secret server-side. Use sandbox for development.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Commercor
EMAIL_MAX_ATTEMPTS=5
