PORT=3001
NODE_ENV=development
CUSTOMER_WEB_ORIGIN=http://localhost:3002
ADMIN_WEB_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SENSITIVE_RATE_LIMIT_MAX=20
# Public storefront reads (categories, products, brands, store-settings, ...).
# SSR traffic from customer-web funnels through one shared upstream IP for
# every visitor combined, so this needs much more headroom than a single
# real client - keep it well above RATE_LIMIT_MAX.
PUBLIC_READ_RATE_LIMIT_MAX=6000
# AI assistant chat - kept separate from the generic write bucket since each
# turn can trigger several Groq API calls.
ASSISTANT_RATE_LIMIT_MAX=20
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=commercorUser
DB_PASSWORD=replace-with-local-password
DB_NAME=commercorDB
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
JWT_SECRET=replace-with-a-long-random-secret
DOMAIN_URL=http://localhost:3002/en

# manual_disabled: checkout blocks until a provider is configured (default).
# manual: cash-on-delivery/pay-manually - checkout completes without a
#   gateway; the payment stays pending/unpaid until staff mark it paid.
# paypal: requires PAYPAL_CLIENT_ID/SECRET/WEBHOOK_ID below.
PAYMENT_PROVIDER=manual_disabled
PAYMENT_PENDING_EXPIRY_MINUTES=30

# PayPal REST Orders v2. Keep the secret server-side. Use sandbox for development.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ALLOW_LIVE=false
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Commercor
# SMTP_FROM is also accepted as an alias for SMTP_FROM_EMAIL.
EMAIL_MAX_ATTEMPTS=5
PASSWORD_RESET_EXPIRY_MINUTES=30
ABANDONED_CART_MINUTES=60
ABANDONED_CART_EMAIL_COOLDOWN_HOURS=24
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
